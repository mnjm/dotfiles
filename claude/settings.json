{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.config/claude/statusline.sh"
  },
  "theme": "auto",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(jq -r .session_id); echo working > \"${TMPDIR:-/tmp}/claude-status-$sid\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sid=$(jq -r .session_id); echo done > \"${TMPDIR:-/tmp}/claude-status-$sid\""
          }
        ]
      }
    ]
  }
}
