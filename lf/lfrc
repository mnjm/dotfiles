# set shell zsh
set shellopts '-eu'
set ifs "\n"
set scrolloff 5
set hidden false
set drawbox true
set ignorecase true
set info size
set icons true
set autoquit true
set previewer '~/.config/lf/preview'

cmd open ${{
    test -L $f && f=$(readlink -f $f)
    case $(file --mime-type $f -b) in
        text/*) $EDITOR $fx;;
        *) for f in $fx; do setsid $OPENER $f > /dev/null 2> /dev/null & done;;
    esac
}}

cmd delete-safe ${{
    tput setaf 3;
    printf "\n%s\n\t" "$fx"
    printf "send to trash?[y/N]"
    read ans
    [ $ans = "y" ] && trash -rf -- $fx && echo "Moved to trash."
    tput sgr0
}}

cmd delete-unsafe ${{
    tput setaf 1;
    printf "\n%s\n\t" "$fx"
    printf "permanent delete?[y/N]"
    read ans
    [ $ans = "y" ] && rm -rf -- $fx && echo "Removed."
    tput sgr0
}}

cmd mkfile ${{
  printf "File Name: "
  read ans
  $EDITOR $ans
}}

cmd new $touch "$@"

cmd chmod ${{
    printf "Mode Bits: "
    read ans

    for file in "$fx"
    do
        chmod $ans $file
    done

    lf -remote 'send reload'
}}

cmd sudomkfile ${{
    printf "(sudo) File Name: "
    read ans
    sudo $EDITOR $ans
}}

cmd fzf_jump ${{
    res="$(find . -maxdepth 3 | fzf --reverse --header='Jump to location')"
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            cmd="cd"
        else
            cmd="select"
        fi
        res="$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        lf -remote "send $id $cmd \"$res\""
    fi
}}

cmd clipboard-copy ${{
    if [ "$(uname)" = Darwin ]; then
        printf "%s" "$fx" | pbcopy
    elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
        if command -v wl-copy >/dev/null 2>&1; then
            printf "%s" "$fx" | wl-copy
        else
            echo "lf: No Wayland clipboard tool found (install wl-clipboard)" >&2
            exit 1
        fi
    elif command -v xclip >/dev/null 2>&1; then
        printf "%s" "$fx" | xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
        printf "%s" "$fx" | xsel --clipboard --input
    else
        echo "lf: No X11 clipboard tool found (install xclip or xsel)" >&2
        exit 1
    fi
}}

# bindings
map e
map gw cd ~/workspace
map D delete-safe
map R delete-unsafe
map <enter> open
map <c-f> fzf_jump
map <c-r> reload
map Y clipboard-copy
