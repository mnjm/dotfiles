# Ignore Everything
*

# Do not ignore contents in these folders
!bin/
!bin/**
!git/
!git/**
!lf/
!lf/**
!nvim/
!nvim/**
!tmux/
!tmux/**
!ghostty/
!ghostty/**
!zed/settings.json
!zed/**
!zsh/
!zsh/**
!herdr/
!herdr/config.toml
!herdr/herdr-sessionizer.sh
!codex/
codex/*
!pi/
!pi/agent/
!pi/agent/AGENTS.md
!pi/agent/skills/
!pi/agent/skills/**
!pi/agent/extensions/
!pi/agent/extensions/**
!codex/skills/
!codex/skills/**
!codex/AGENTS.md
!codex/config.toml

# Claude Code: whitelist only portable config (no credentials, history,
# sessions, caches, plugins, synced skills, or .claude.json state)
!claude/
claude/*
!claude/settings.json
!claude/CLAUDE.md
!claude/skills/
claude/skills/*
!claude/skills/*
claude/skills/synced
!claude/agents/
!claude/agents/**
!claude/commands/
!claude/commands/**
!claude/hooks/
!claude/hooks/**
!claude/keybindings.json
claude/settings.local.json

!.gitignore
!README.md

# Ignore some "inner" files in the above listed folders
ghostty/config.local
.zcompdump
.zsh_history
.zsh_sessions/
.zshrc_local
zsh-autosuggestions/
zsh-syntax-highlighting/
nvim/lazy-lock.json
bin/__pycache__/
git/__pycache__/**
codex/skills/.system
agent/extensions/herdr-agent-state.ts
