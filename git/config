[alias]
    alias = config --get-regexp ^alias
    ; pretty log listing
    l = !"f() { git --no-pager log --pretty=format:'%C(auto)%h %s %C(green)(%an)%C(auto) %d' --abbrev-commit --graph --decorate=short --color=always "$@" | less -R; }; f"
    ll = !"f() { git --no-pager log --graph --abbrev-commit --decorate=short --color=always "$@" | less -R; }; f"
    lf = !"f() { git --no-pager log --graph --abbrev-commit --decorate=short --color=always --name-status "$@" | less -R; }; f"
    rl = !"f() { git --no-pager reflog --color=always "$@" | less -R; }; f"
    s = status -s
    ss = status
    d = diff
    ds = diff --staged
    dt = difftool -y
    dts = difftool -y --staged
    dp = !git-diff-previewer
    dps = !git-diff-previewer --staged
    a = add -v
    au = add -vu
    b = branch
    c = commit
    cam = commit --amend
    sw = switch
    co = checkout
    cp = cherry-pick
    p = !git push origin $(git branch --show-current)
    pls = push --force-with-lease
    pu = pull
    pr = !"f() { git fetch origin pull/"$1"/head:pr/"$1"; }; f"
    st = stash
    ; fixup with search
    fixup = !"f() { git commit --fixup ":/$*"; }; f"
    m = merge --ff-only
    ; explicitly create merge commit
    mf = merge --no-ff
    f = fetch
    wtl = !$HOME/.config/bin/git-worktree list
    ; `git wta <ref>` adds ../<repo>-<ref> and copies files from worktree-files.list.
    wta = !$HOME/.config/bin/git-worktree add
    ; `git wtr <ref>` removes ../<repo>-<ref>.
    wtr = !$HOME/.config/bin/git-worktree remove
    link = !git-link
    ; create temp wip commit
    wip = !"f() { git add -Av && git commit -m '[WIP]' && git commit --amend --quiet; }; f"
    ; remove last commit stage the changes
    uncommit = reset --soft HEAD^
    ; unstage all changes
    unstage = reset --mixed HEAD --
    ; remove untracked changes
    restore-staged = restore --worktree
    ; restore file to HEAD
    restore-head = restore --staged --worktree
    ; re setup target origin branch
    track-current = !b=$(git branch --show-current) && git branch --set-upstream-to=origin/$b $b
    ; rebase
    rb = rebase
    rbi = rebase --interactive
    rba = rebase --abort
    rbc = rebase --continue
    ; prune off remote tracking branches that are removed in remote
    remote-refresh = remote update --prune

[core]
    pager = less
    editor = nvim
    excludesfile = ~/.config/git/ignore

[pager]
    diff = delta --side-by-side
    d = delta --side-by-side
    ds = delta --side-by-side

[color]
    ui = auto

[difftool]
    prompt = true

[help]
    autocorrect = 0

[interactive]
    diffFilter = delta --color-only

[add.interactive]
    useBuiltin = false # required for git 2.37.0

[include]
    path = ~/.config/git/delta_themes.config

[includeIf "gitdir:/home/mnjm/workspace/"]
    path = ~/.config/git/workspace.gitconfig

[includeIf "gitdir:/home/mnjm/personalspace/"]
    path = ~/.config/git/personalspace.gitconfig

[delta]
    features = calochortus-lyallii
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    side-by-side = false

[merge]
    conflictstyle = diff3

[init]
    defaultBranch = main

[pull]
    ff = only

[rebase]
    autosquash = true

[advice]
    addIgnoredFiles = false

[rerere]
	enabled = true

[column]
    ui = auto

[branch]
    sort = -committerdate
