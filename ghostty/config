font-family = UbuntuMono Nerd Font
font-size = 15

# Optional machine-specific settings override the shared defaults.
config-file = ?config.local

background = #000000
background-opacity = 0.87
# Keep transparency when applications such as tmux or Neovim paint a background.
background-opacity-cells = true

# "Colors (base16)" ANSI palette.
foreground = #bbbbbb
cursor-color = #bbbbbb
palette = 0=#111111
palette = 1=#ff4136
palette = 2=#2ecc40
palette = 3=#ffdc00
palette = 4=#0074d9
palette = 5=#b10dc9
palette = 6=#7fdbff
palette = 7=#bbbbbb
palette = 8=#777777
palette = 9=#ff4136
palette = 10=#2ecc40
palette = 11=#ffdc00
palette = 12=#0074d9
palette = 13=#b10dc9
palette = 14=#7fdbff
palette = 15=#ffffff

# Does not dim inactive panes by default.
unfocused-split-opacity = 1

# Start at home. New tabs and splits continue in the current project's directory.
working-directory = home
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-new-tab-position = current

maximize = true
cursor-style = block
shell-integration-features = no-cursor
