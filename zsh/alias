# clipboard copy
function copi() {
  if [[ "$OSTYPE" == darwin* ]]; then
    pbcopy "$@"
  elif [[ "$OSTYPE" == linux-gnu* || "$OSTYPE" == linux-musl* ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      if command -v wl-copy >/dev/null 2>&1; then
        wl-copy "$@"
      else
        echo "copi: No Wayland clipboard tool found (install wl-clipboard)" >&2
        return 1
      fi
    elif command -v xclip >/dev/null 2>&1; then
      xclip -selection clipboard "$@"
    elif command -v xsel >/dev/null 2>&1; then
      xsel --clipboard "$@"
    else
      echo "copi: No X11 clipboard tool found (install xclip or xsel)" >&2
      return 1
    fi
  else
    echo "copi: Unsupported OS: $OSTYPE" >&2
    return 1
  fi
}

pasti() {
  if [[ "$OSTYPE" == darwin* ]]; then
    pbpaste "$@"
  elif [[ "$OSTYPE" == linux-gnu* || "$OSTYPE" == linux-musl* ]]; then
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
      if command -v wl-paste >/dev/null 2>&1; then
        wl-paste "$@"
      else
        echo "pasti: No Wayland clipboard tool found (install wl-clipboard)" >&2
        return 1
      fi
    elif command -v xclip >/dev/null 2>&1; then
      xclip -selection clipboard -o "$@"
    elif command -v xsel >/dev/null 2>&1; then
      xsel --clipboard --output "$@"
    else
      echo "pasti: No X11 clipboard tool found (install xclip or xsel)" >&2
      return 1
    fi
  else
    echo "pasti: Unsupported OS: $OSTYPE" >&2
    return 1
  fi
}

# Safe Remove
function safe_rm() {
    rm -vI "$@"
}
# replace rm with trash
alias rm='safe_rm'

# safe move and copy
alias mv='mv -vi'
alias cp='cp -vi'

# find real abosolute path of the file
alias ppath='readlink -f'

function gopen() {
  case "$OSTYPE" in
    darwin*)  # macOS
      open "$@"
      ;;
    linux-gnu*|linux-musl*)
      if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$@" >/dev/null 2>&1;
      elif command -v gio >/dev/null 2>&1; then
        gio open "$@" >/dev/null 2>&1;
      elif grep -qi microsoft /proc/version 2>/dev/null; then
        # WSL (Windows Subsystem for Linux)
        explorer.exe "$@"
      else
        echo "gopen: No graphical open command found (need xdg-open, gio, or explorer.exe)" >&2
        return 1
      fi
      ;;
    *)
      echo "gopen: Unsupported OS ($OSTYPE)" >&2
      return 1
      ;;
  esac
}

