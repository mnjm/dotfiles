#!/usr/bin/env bash

tmp=$(mktemp vclip.XXXXX -p /tmp/) || {
  echo "Failed to create temp file" >&2
  exit 1
}

# Ensure we always quote variable expansions
if [[ "$OSTYPE" == darwin* ]]; then
  # macOS: no trap, remove temp file at end
  if command -v pbpaste >/dev/null 2>&1 && command -v pbcopy >/dev/null 2>&1; then
    pbpaste > "$tmp"
    "${EDITOR:-vi}" "$tmp"
    cat "$tmp" | pbcopy
    rm -f "$tmp" >/dev/null 2>&1
    exit 0
  else
    echo "vclip: pbpaste/pbcopy not found on this macOS system." >&2
    rm -f "$tmp" >/dev/null 2>&1
    exit 1
  fi

elif [[ "$OSTYPE" == linux-gnu* || "$OSTYPE" == linux-musl* ]]; then
  # Linux: set up trap for cleanup
  cleanup() {
    rm -f "$tmp" >/dev/null 2>&1
  }
  trap 'cleanup' HUP INT QUIT TERM EXIT

  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    if ! command -v wl-paste >/dev/null 2>&1 || ! command -v wl-copy >/dev/null 2>&1; then
      echo "vclip: No Wayland clipboard tool found (install wl-clipboard)." >&2
      exit 1
    fi
    wl-paste > "$tmp"
    "${EDITOR:-vi}" "$tmp"
    cat "$tmp" | wl-copy
    exit 0

  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -o > "$tmp"
    "${EDITOR:-vi}" "$tmp"
    cat "$tmp" | xclip -selection clipboard -i
    exit 0

  elif command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --output > "$tmp"
    "${EDITOR:-vi}" "$tmp"
    cat "$tmp" | xsel --clipboard --input
    exit 0

  else
    echo "vclip: No X11 clipboard tool found (install xclip or xsel)." >&2
    exit 1
  fi

else
  echo "vclip: Unsupported OS: $OSTYPE" >&2
  rm -f "$tmp" >/dev/null 2>&1
  exit 1
fi
